rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthed() && request.auth.token.role == 'admin';
    }

    function isNotDeleted() {
      return !('isDeleted' in resource.data) || resource.data.isDeleted == false;
    }

    // ── Players ──────────────────────────────────────────────────────────────

    // Players can read/write their own profile only.
    // All writes go through Cloud Functions (server-authoritative),
    // so client writes are blocked here — remove the deny line if you need
    // direct client writes during prototyping.
    match /players/{uid} {
      allow read:  if isOwner(uid) && isNotDeleted();
      allow write: if isAdmin();  // only backend writes

      // Progress is fully server-side
      match /progress/{gameId} {
        allow read:  if isOwner(uid);
        allow write: if isAdmin();
      }

      // Sessions — read-only for owner, written by backend
      match /sessions/{sessionId} {
        allow read:  if isOwner(uid);
        allow write: if isAdmin();
      }
    }

    // ── Game Config (read-only for all authed users) ──────────────────────────
    match /gameConfig/{document=**} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Leaderboards (read all, write via backend only) ───────────────────────
    match /leaderboards/{gameId}/{document=**} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
